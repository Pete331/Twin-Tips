# Copy to .env and fill in. Never commit the real .env - it is gitignored.
#
# On Render these are set in the dashboard rather than in a file, and
# render.yaml declares which ones each service needs.

# Where the app is reachable. Password reset emails build their link from this,
# so if it is wrong the mail still sends and the link goes nowhere. The server
# refuses to start in production without it. Locally the default is fine.
APP_URL=http://localhost:3001

# Include the database name before any query string. Without /twin-tips the
# driver connects to "test" and the app starts cleanly against no data.
MONGODB_URI=mongodb://localhost/twin-tips

# Signs the session cookie. Anything long and random; on Render this is
# generated for you. The server refuses to start in production without it.
SESSION_SECRET=change-me-to-something-long-and-random

# Squiggle asks for a contact address in the User-Agent and may refuse or ban
# requests that omit one.
SQUIGGLE_CONTACT=your.name@example.com

# How password reset email is sent. Two ways, and which one you need depends
# on where the app runs.
#
# BREVO_API_KEY is the one production needs. Render blocks outbound SMTP on 25,
# 465 and 587 from free services - the ban is on the ports, not on any one
# provider - so no SMTP host is reachable from there. The HTTP API is an
# ordinary HTTPS call on 443 and goes straight through. It is NOT the SMTP key:
# Brevo dashboard -> SMTP & API -> API Keys -> Generate. Starts xkeysib-.
#
# When BREVO_API_KEY is set, the SMTP settings below are ignored.
BREVO_API_KEY=

# SMTP, for local work or anywhere outbound mail ports are open.
#
# The server checks these on boot and says so if they are missing or rejected,
# rather than leaving it to be found by somebody already locked out of their
# account. Password reset is the only thing that needs them; the rest of the
# app runs without.
#
# Port 465 is implicit TLS and anything else is treated as STARTTLS, so the
# port decides. Render blocks outbound SMTP from free services, which is why
# Gmail cannot work there however it is configured.
#
#   Brevo   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=587
#   Gmail   SMTP_HOST=smtp.gmail.com         SMTP_PORT=465
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-provider-login
SMTP_PASSWORD=your-provider-key

# Who the mail comes from. Required - there is no default, deliberately. It
# must be an address the provider has verified, or the provider accepts the
# message and quietly never delivers it. The server refuses to call itself
# configured without this, so a deployment missing it says so on boot.
MAIL_FROM=twintips@example.com

# The previous names for the login and password above. Still read when the
# SMTP_* pair is unset, so an existing deployment keeps sending until it moves.
EMAIL_USER=
EMAIL_PASSWORD=

# NODE_ENV is not set here. Setting it to production locally also turns on
# secure cookies, which a browser will not store over plain http - so login
# stops working. The built client is served whenever client/build exists,
# regardless of this, so a production build can be checked without it.
