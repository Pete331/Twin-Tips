// Tests for the scoring engine.
//
//   npm test
//
// This file is deliberately the only tested module for now. Most of the
// codebase is glue around a database, where a test costs more than it catches -
// but this is pure logic that takes fixtures and tips and returns who won, it
// touches no I/O, and it decides who gets paid. It has also already carried two
// bugs of the same kind, both found by reading rather than by anything
// automatic, and one of them survived a spot-check that passed by coincidence:
//
//   - `topEightDifference || bottomTenDifference` discarded an exact margin,
//     because a difference of 0 - the best possible tip - is falsy.
//   - marginDifference read marginTopEight off an object that never carried it,
//     so every tipster who put their margin on the top-8 pick was dropped from
//     contention. Round 19 went to a margin of 35 while 23 sat unread.
//
// Both are covered below.

const test = require("node:test");
const assert = require("node:assert/strict");

const { scoreSelection, scoreTip, pickWinners } = require("./results");

// A round of two games. Geelong win by 30, the Bulldogs game is drawn.
const games = [
  {
    hteam: "Geelong",
    ateam: "Essendon",
    hscore: 100,
    ascore: 70,
    winner: "Geelong",
  },
  {
    hteam: "Western Bulldogs",
    ateam: "North Melbourne",
    hscore: 80,
    ascore: 80,
    winner: null,
  },
];

test("scoreSelection", async (t) => {
  await t.test("a correct pick scores the distance from the real margin", () => {
    const r = scoreSelection("Geelong", 20, games);
    assert.equal(r.points, 1);
    assert.equal(r.difference, 10); // real 30, predicted 20
  });

  await t.test("an exact margin scores zero, the best possible", () => {
    const r = scoreSelection("Geelong", 30, games);
    assert.equal(r.points, 1);
    assert.equal(r.difference, 0);
  });

  await t.test("a wrong pick is penalised by the sum", () => {
    const r = scoreSelection("Essendon", 20, games);
    assert.equal(r.points, 0);
    assert.equal(r.difference, 50); // real 30 + predicted 20
  });

  await t.test("a pick with no margin is scored but has no difference", () => {
    const r = scoreSelection("Geelong", undefined, games);
    assert.equal(r.points, 1);
    assert.equal(r.difference, null);
  });

  // The rules have always said so - "a drawn match is equivalent to half a
  // win" - but the code scored a draw as a loss, so a round containing one
  // could go to the wrong tipster.
  await t.test("a draw is half a win to whoever picked either side", () => {
    for (const side of ["Western Bulldogs", "North Melbourne"]) {
      const r = scoreSelection(side, 10, games);
      assert.equal(r.points, 0.5, `${side} should score half in a draw`);
      assert.equal(r.difference, 10); // real margin 0, predicted 10
    }
  });

  // Three outcomes that a boolean could not hold, and which the dashboard
  // colours differently: null is a game not yet played and stays uncoloured,
  // where 0 is a pick that lost.
  await t.test("half, nothing and not-yet are three different answers", () => {
    assert.equal(scoreSelection("Western Bulldogs", 10, games).points, 0.5);
    assert.equal(scoreSelection("Essendon", 10, games).points, 0);
    assert.equal(scoreSelection("Carlton", 10, games).points, null);
  });

  await t.test("a team that did not play this round scores nothing", () => {
    const r = scoreSelection("Carlton", 20, games);
    assert.equal(r.points, null);
    assert.equal(r.difference, null);
  });

  await t.test("an empty selection scores nothing", () => {
    assert.deepEqual(scoreSelection("", 20, games), {
      points: null,
      difference: null,
    });
  });
});

test("scoreTip picks the margin off the game it was entered against", async (t) => {
  await t.test("margin on the top-8 selection", () => {
    const r = scoreTip(
      {
        topEightSelection: "Geelong",
        marginTopEight: 25,
        bottomTenSelection: "North Melbourne",
        marginBottomTen: 0,
      },
      games
    );
    assert.equal(r.correctTips, 1); // Geelong won, the other game was drawn
    assert.equal(r.topEightDifference, 5);
    // The whole point: the counted difference is the top-8 one, not the
    // bottom-10 one that happens to also have a value.
    assert.equal(r.countedDifference, 5);
  });

  await t.test("margin on the bottom-10 selection", () => {
    const r = scoreTip(
      {
        topEightSelection: "Geelong",
        marginTopEight: 0,
        bottomTenSelection: "North Melbourne",
        marginBottomTen: 10,
      },
      games
    );
    assert.equal(r.countedDifference, 10);
  });

  await t.test("an exact margin survives as a real zero, not as absent", () => {
    const r = scoreTip(
      {
        topEightSelection: "Geelong",
        marginTopEight: 30,
        bottomTenSelection: "North Melbourne",
        marginBottomTen: 0,
      },
      games
    );
    // The original bug: 0 is falsy, so the strongest tip in the round read as
    // no tip at all and its owner was dropped from contention.
    assert.equal(r.countedDifference, 0);
    assert.notEqual(r.countedDifference, null);
  });

  await t.test("both selections correct counts two", () => {
    const r = scoreTip(
      {
        topEightSelection: "Geelong",
        marginTopEight: 30,
        bottomTenSelection: "Essendon",
        marginBottomTen: 0,
      },
      games
    );
    assert.equal(r.correctTips, 1); // Essendon lost
  });
});

test("pickWinners", async (t) => {
  const tip = (user, correctTips, countedDifference) => ({
    user,
    correctTips,
    countedDifference,
  });

  await t.test("most correct tips wins before any margin is considered", () => {
    const winners = pickWinners([
      tip("alice", 2, 40),
      tip("bob", 1, 0),
    ]);
    assert.deepEqual(winners, ["alice"]);
  });

  await t.test("among equals, the closest margin wins", () => {
    const winners = pickWinners([
      tip("alice", 1, 35),
      tip("bob", 1, 23),
      tip("carol", 1, 60),
    ]);
    assert.deepEqual(winners, ["bob"]);
  });

  await t.test("an exact margin beats a near one", () => {
    // The round 19 shape: a margin of 0 must not be read as "no margin".
    const winners = pickWinners([
      tip("alice", 1, 35),
      tip("bob", 1, 0),
    ]);
    assert.deepEqual(winners, ["bob"]);
  });

  await t.test("a tie on both counts splits the round", () => {
    const winners = pickWinners([
      tip("alice", 1, 12),
      tip("bob", 1, 12),
      tip("carol", 1, 30),
    ]);
    assert.deepEqual(winners.sort(), ["alice", "bob"]);
  });

  await t.test("with nobody predicting a margin, tip count alone decides", () => {
    const winners = pickWinners([
      tip("alice", 1, null),
      tip("bob", 1, null),
    ]);
    assert.deepEqual(winners.sort(), ["alice", "bob"]);
  });

  await t.test("someone who entered a margin beats someone who did not", () => {
    const winners = pickWinners([
      tip("alice", 1, null),
      tip("bob", 1, 50),
    ]);
    assert.deepEqual(winners, ["bob"]);
  });

  await t.test("an empty round has no winner", () => {
    assert.deepEqual(pickWinners([]), []);
  });

  await t.test("everyone scoring zero still produces winners", () => {
    const winners = pickWinners([tip("alice", 0, 20), tip("bob", 0, 5)]);
    assert.deepEqual(winners, ["bob"]);
  });
});
