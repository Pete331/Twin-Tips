# For the editor, before Prettier ever runs - and for files Prettier does not
# format. The two agree: Prettier reads indentation and line endings from here.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
